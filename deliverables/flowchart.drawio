<mxfile host="app.diagrams.net"><diagram name="Pipeline" id="pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1945" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Classifying 5M bank documents on a &amp;#8377;1,00,000 budget: how one document moves through the pipeline&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;How to read this flowchart&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Follow one document from the top.&lt;/b&gt; Each blue box is a step that buys evidence about it; its cost is in brackets, and the steps get dearer as you go down.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. The document carries a probability for each of the 15 classes.&lt;/b&gt; It starts from the class mix expected for its file format (never 0), and every blue step updates it (Bayes&#x27; rule).&lt;br&gt;&lt;br&gt;&lt;b&gt;3. After each step a diamond decides.&lt;/b&gt; &lt;b&gt;&lt;font color=&#x27;#1b7a2f&#x27;&gt;YES&lt;/font&gt;&lt;/b&gt;: one class is sure enough, so stop and accept. &lt;b&gt;&lt;font color=&#x27;#c0262d&#x27;&gt;NO&lt;/font&gt;&lt;/b&gt;: buy the next, dearer step. Orange diamonds use the movable gate &amp;tau;; yellow ones are fixed checks. The purple box splits KYC IDs into Proof of Identity or Proof of Address.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Every document ends in one of two places:&lt;/b&gt; ACCEPT (green), with its label, confidence and the step that settled it, or a person (red).&lt;br&gt;&lt;br&gt;&lt;b&gt;5. The three boxes at the top right apply at every orange diamond:&lt;/b&gt; what &amp;tau; is, the critical safety net, and the budget controller that moves &amp;tau;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why 95%:&lt;/b&gt; an accepted document is then wrong at most 5% of the time, and each next step costs several times the last, so stopping as soon as one class is sure is the cheapest way to the bar (macro-F1 &amp;ge; 0.85, critical recall &amp;ge; 0.90).&lt;br&gt;&lt;br&gt;&lt;b&gt;Why &amp;tau; moves only at the gates before the LLM:&lt;/b&gt; reading pages is where most of the money goes, so that is where the controller trades accuracy for spend; never for critical documents." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="430" height="390" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;S3 bucket&lt;/b&gt;&lt;br&gt;5M objects + the free manifest&lt;br&gt;(key, size, checksum)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="470" y="75" width="300" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;L0 Open the file&lt;/b&gt; (3 ms, no model)&lt;br&gt;true type from the bytes; trusted visible text vs scan;&lt;br&gt;emails and zips unpacked; start from P(class | format)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="175" width="300" height="75" as="geometry"/></mxCell><mxCell id="n5" value="Same checksum&lt;br&gt;as a file seen before?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="290" width="180" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Copy the first copy&#x27;s label&lt;br&gt;(free)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="305" width="170" height="50" as="geometry"/></mxCell><mxCell id="n7" value="Trusted visible&lt;br&gt;text on page 1?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="475" width="180" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;L2 on the free text&lt;/b&gt; (~1 ms)&lt;br&gt;letter-piece model + ID checks&lt;br&gt;(checksum-valid IDs are evidence, not verdicts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="290" height="70" as="geometry"/></mxCell><mxCell id="n9" value="Top class&lt;br&gt;&amp;ge; &amp;tau;?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="130" y="595" width="130" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Bundle splitter&lt;/b&gt; (multi-page files)&lt;br&gt;every page: L1 layout + page-number line;&lt;br&gt;new document where P(boundary) &amp;ge; 0.40;&lt;br&gt;&amp;quot;Page 3&amp;quot; never starts one, &amp;quot;Page 1&amp;quot; always does" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="605" width="300" height="80" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;L1 Layout&lt;/b&gt; (0.11 s/page)&lt;br&gt;DiT (frozen, MIT) + 6 readable signals&lt;br&gt;+ logistic regression, temperature-calibrated&lt;br&gt;settles 64% of scanned documents at 100.0%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="730" width="300" height="80" as="geometry"/></mxCell><mxCell id="n12" value="Top class&lt;br&gt;&amp;ge; &amp;tau;?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="555" y="855" width="130" height="80" as="geometry"/></mxCell><mxCell id="n13" value="Is it a&lt;br&gt;KYC ID document?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="885" y="855" width="150" height="80" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Address question&lt;/b&gt;&lt;br&gt;full read of the card;&lt;br&gt;valid PIN + address label or state&lt;br&gt;&amp;rarr; PoA, otherwise PoI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1090" y="850" width="230" height="90" as="geometry"/></mxCell><mxCell id="n15" value="P(KYC) &amp;times; P(answer)&lt;br&gt;&amp;ge; 95%?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="990" width="170" height="80" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Reading ladder + L2 text model&lt;/b&gt;&lt;br&gt;rung 2 selective read: top and largest lines (0.48 s)&lt;br&gt;rung 3 full page (2.2 s)&lt;br&gt;rung 4 next informative page + last page&lt;br&gt;&lt;i&gt;each rung replaces the last rung&#x27;s text evidence&lt;/i&gt;&lt;br&gt;legal/property: later pages first (the e-stamp page is shared)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="995" width="300" height="112" as="geometry"/></mxCell><mxCell id="n17" value="Top class &amp;ge; &amp;tau;?&lt;br&gt;(after each rung)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="530" y="1165" width="180" height="95" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;L3 LLM&lt;/b&gt;: Haiku via &lt;code&gt;claude -p&lt;/code&gt;, tools off&lt;br&gt;masked text (IDs replaced by their type);&lt;br&gt;2-5 candidate classes + &amp;quot;none of these&amp;quot;;&lt;br&gt;answer used as a sensor with a measured error rate&lt;br&gt;mode: quote, ~&amp;#8377;0.038 per call" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="1320" width="300" height="100" as="geometry"/></mxCell><mxCell id="n19" value="Top class&lt;br&gt;&amp;ge; 95%?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="555" y="1480" width="130" height="80" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;L4 Human review&lt;/b&gt;&lt;br&gt;no price quoted: counted, not costed&lt;br&gt;about 2,600 of 5M documents (dev-test 0.1%)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="1615" width="300" height="60" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;ACCEPT&lt;/b&gt;&lt;br&gt;label, confidence, the step that settled it, its cost&lt;br&gt;(bundles: one row per document inside, with its page range)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1055" y="1610" width="300" height="70" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Apply at every orange diamond&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="290" height="25" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Critical safety net&lt;/b&gt;&lt;br&gt;if P(Legal, Property, PoI or PoA) &amp;ge; 10%,&lt;br&gt;the document&#x27;s gate never drops below 95%" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="290" height="70" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&amp;tau;&lt;/b&gt; = the gate at every orange diamond:&lt;br&gt;95% by default; the controller moves it&lt;br&gt;between 85% and 99%" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1090" y="255" width="290" height="65" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Budget controller&lt;/b&gt;&lt;br&gt;after every batch: spend vs a straight plan line&lt;br&gt;target &amp;#8377;50k, 10% reserve (aims at &amp;#8377;45k)&lt;br&gt;over plan &amp;rarr; lower &amp;tau;&lt;br&gt;under plan &amp;rarr; raise &amp;tau; only if that is measured&lt;br&gt;to buy accuracy (it did not: held at 95%)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1090" y="375" width="290" height="115" as="geometry"/></mxCell><mxCell id="e26" value="moves &amp;tau;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n25" target="n24"><mxGeometry x="-0.2000" relative="1" as="geometry"><mxPoint x="46.1" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="&lt;b&gt;&lt;font color=&quot;#1b7a2f&quot;&gt;YES&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry x="-0.7473" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e30" value="&lt;b&gt;&lt;font color=&quot;#c0262d&quot;&gt;NO&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7"><mxGeometry x="-0.5810" relative="1" as="geometry"><mxPoint x="13.3" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e31" value="&lt;b&gt;&lt;font color=&quot;#1b7a2f&quot;&gt;YES&lt;/font&gt;&lt;/b&gt;: digital files" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry x="-0.2242" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e32" value="&lt;b&gt;&lt;font color=&quot;#c0262d&quot;&gt;NO&lt;/font&gt;&lt;/b&gt;: scans, photos" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n10"><mxGeometry x="-0.1200" relative="1" as="geometry"><mxPoint x="68.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="&lt;b&gt;&lt;font color=&quot;#c0262d&quot;&gt;NO&lt;/font&gt;&lt;/b&gt;: add layout" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n11"><mxGeometry x="-0.6574" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset"/><Array as="points"><mxPoint x="390" y="635"/><mxPoint x="390" y="770"/></Array></mxGeometry></mxCell><mxCell id="e35" value="&lt;b&gt;&lt;font color=&quot;#1b7a2f&quot;&gt;YES&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n21"><mxGeometry x="-0.9791" relative="1" as="geometry"><mxPoint x="16.9" y="0.0" as="offset"/><Array as="points"><mxPoint x="195" y="1725"/><mxPoint x="1205" y="1725"/></Array></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="&lt;b&gt;&lt;font color=&quot;#1b7a2f&quot;&gt;YES&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n13"><mxGeometry x="-0.8105" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e39" value="&lt;b&gt;&lt;font color=&quot;#c0262d&quot;&gt;NO&lt;/font&gt;&lt;/b&gt;: buy the cheapest read&lt;br&gt;that can split what&#x27;s left" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n16"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="100.9" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e40" value="&lt;b&gt;&lt;font color=&quot;#1b7a2f&quot;&gt;YES&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n14"><mxGeometry x="-0.3109" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e41" value="&lt;b&gt;&lt;font color=&quot;#c0262d&quot;&gt;NO&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n21"><mxGeometry x="-0.9713" relative="1"