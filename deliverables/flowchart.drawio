<mxfile host="app.diagrams.net"><diagram name="Pipeline" id="pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;S3 bucket&lt;/b&gt;&lt;br&gt;5M objects + the free manifest&lt;br&gt;(key, size, checksum)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="300" height="60" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;L0 Open the file&lt;/b&gt; (~2.5 ms, no model)&lt;br&gt;true type from the bytes; trusted visible text vs scan;&lt;br&gt;emails and zips unpacked; start from P(class | format)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="300" height="75" as="geometry"/></mxCell><mxCell id="n3" value="Same checksum&lt;br&gt;as a file seen before?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="210" width="180" height="80" as="geometry"/></mxCell><mxCell id="n4" value="Copy the first copy&#x27;s label&lt;br&gt;(free)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="225" width="170" height="50" as="geometry"/></mxCell><mxCell id="n5" value="Trusted visible&lt;br&gt;text on page 1?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="320" width="180" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;L2 on the free text&lt;/b&gt; (~1 ms)&lt;br&gt;letter-piece model + ID checks&lt;br&gt;(checksum-valid IDs are evidence, not verdicts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="270" height="70" as="geometry"/></mxCell><mxCell id="n7" value="Top class&lt;br&gt;&amp;ge; &amp;tau;?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="140" y="430" width="130" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Bundle splitter&lt;/b&gt; (multi-page files)&lt;br&gt;every page: L1 layout + page-number line;&lt;br&gt;new document where P(boundary) &amp;ge; 0.40;&lt;br&gt;&amp;quot;Page 3&amp;quot; never starts one, &amp;quot;Page 1&amp;quot; always does" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="300" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;L1 Layout&lt;/b&gt; (0.14 s/page)&lt;br&gt;DiT (frozen, MIT) + 6 readable signals&lt;br&gt;+ logistic regression, temperature-calibrated&lt;br&gt;settles 64% of documents at 100.0%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="525" width="300" height="80" as="geometry"/></mxCell><mxCell id="n10" value="Top class&lt;br&gt;&amp;ge; &amp;tau;?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="555" y="635" width="130" height="80" as="geometry"/></mxCell><mxCell id="n11" value="Is it a&lt;br&gt;KYC ID document?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="635" width="150" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Address question&lt;/b&gt; (D24)&lt;br&gt;full read of the card;&lt;br&gt;valid PIN + address label or state&lt;br&gt;&amp;rarr; PoA, otherwise PoI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1090" y="630" width="230" height="90" as="geometry"/></mxCell><mxCell id="n13" value="P(KYC) &amp;times; P(answer)&lt;br&gt;&amp;ge; 95%?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1125" y="750" width="160" height="80" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Reading ladder + L2 text model&lt;/b&gt;&lt;br&gt;rung 2 selective read: top and largest lines (0.63 s)&lt;br&gt;rung 3 full page (2.9 s)&lt;br&gt;rung 4 next informative page + last page&lt;br&gt;&lt;i&gt;each rung replaces the last rung&#x27;s text evidence&lt;/i&gt;&lt;br&gt;legal/property: later pages first (the e-stamp page is shared)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="745" width="300" height="112" as="geometry"/></mxCell><mxCell id="n15" value="Top class &amp;ge; &amp;tau;?&lt;br&gt;(after each rung)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="530" y="905" width="180" height="95" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Critical safety net&lt;/b&gt;&lt;br&gt;if P(Legal, Property, PoI or PoA) &amp;ge; 10%,&lt;br&gt;the document&#x27;s gate never drops below 95%" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="140" y="915" width="250" height="70" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;&amp;tau;&lt;/b&gt; = the gate at every orange diamond:&lt;br&gt;95% by default; the controller moves it&lt;br&gt;between 85% and 99%" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="140" y="1010" width="250" height="60" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;L3 LLM&lt;/b&gt;: Haiku via &lt;code&gt;claude -p&lt;/code&gt;, tools off&lt;br&gt;masked text (IDs replaced by their type);&lt;br&gt;2-5 candidate classes + &amp;quot;none of these&amp;quot;;&lt;br&gt;answer used as a sensor with a measured error rate&lt;br&gt;mode: quote, ~&amp;#8377;0.038 per call" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="300" height="100" as="geometry"/></mxCell><mxCell id="n19" value="Top class&lt;br&gt;&amp;ge; 95%?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="555" y="1255" width="130" height="80" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;L4 Human review&lt;/b&gt;&lt;br&gt;benchmark &amp;#8377;1 per document&lt;br&gt;dev-test share: 0.1%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="1370" width="300" height="60" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;ACCEPT&lt;/b&gt;&lt;br&gt;label, confidence, the step that settled it, its cost&lt;br&gt;(bundles: one row per document inside, with its page range)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1090" y="1365" width="300" height="70" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Budget controller&lt;/b&gt;&lt;br&gt;after every batch: spend vs a straight plan line&lt;br&gt;target &amp;#8377;50k, 10% reserve (aims at &amp;#8377;45k)&lt;br&gt;over plan &amp;rarr; lower &amp;tau;&lt;br&gt;under plan &amp;rarr; raise &amp;tau; only if that is measured&lt;br&gt;to buy accuracy (it did not: held at 95%)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1090" y="960" width="270" height="100" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="yes: digital PDF, DOCX,&lt;br&gt;XLSX, TXT, email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="no: add layout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="no: scans, photos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=1;entryY=0.25;" edge="1" parent="1" source="n11" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n13" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="no: buy the cheapest read&lt;br&gt;that can split what&#x27;s left" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n15" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="no: next rung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="n15" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="no, after rung 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="n16" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="n17" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e47" value="moves &amp;tau;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="n22" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e49" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" value="no / none of these" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;The rule at every gate&lt;/b&gt;&lt;br&gt;Each document carries a probability for every class, starting from P(class | format), never 0.&lt;br&gt;Every step multiplies in its evidence (Bayes) and the document stops when one class reaches the gate.&lt;br&gt;Otherwise it buys the cheapest next piece of evidence that can separate the classes still in play.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why 95%:&lt;/b&gt; an accepted document is then wrong at most 5% of the time, and the measured accuracy of&lt;br&gt;accepted documents is higher; the next step costs 3-10x the last, so stopping as soon as one is sure is&lt;br&gt;the cheap way to the bar (macro-F1 &amp;ge; 0.85, critical recall &amp;ge; 0.90).&lt;br&gt;&lt;b&gt;Why one movable gate (&amp;tau;) before the LLM:&lt;/b&gt; reading pages is where most of the money goes, so the&lt;br&gt;controller trades accuracy for spend at every gate before the LLM, and never for critical documents." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1460" width="640" height="175" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b&gt;Measured (synthetic documents)&lt;/b&gt;&lt;br&gt;dev-test macro-F1 0.998; critical recall 1.00 on all four&lt;br&gt;Lockbox A (sealed, unseen layouts, run once): macro-F1 0.990&lt;br&gt;reaching the LLM: 0.4%; reaching humans: 0.1%&lt;br&gt;5M run: &amp;#8377;24,192 vs &amp;#8377;130,170 brute force" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="1460" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>